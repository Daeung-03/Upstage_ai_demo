UPSTAGE_API_KEY=your_upstage_api_key_here
# 추가 키 (선택) — scripts/run_all_fixtures.py가 자동으로 라운드로빈 분배함.
# UPSTAGE_API_KEY_2=second_key_here
# UPSTAGE_API_KEY_3=third_key_here
# UPSTAGE_API_KEY_4=fourth_key_here
# Default: https://api.upstage.ai/v1 (v2는 Agent API 전용). 라인 삭제하면 디폴트 사용.
# UPSTAGE_BASE_URL=https://api.upstage.ai/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname