 "citation": null}, "notice_period_days": {"value": null, "uncertainty": "not_specified", "citation": null}, "penalty_present": {"value": false, "uncertainty": "confirmed", "citation": {"page": 2, "section": "paragraph", "bbox": null, "quote": "귀하가 본 약관 중 일부라도 동의하지 않거나 이에 대한 당사의 해석을 정확히 이해할 수 없는 경우, 동의하지 않음을 클릭하거나 당사 서비스 이용을 중단하시기 바랍니다.", "pain_point_id": null}}, "penalty_description": {"value": null, "uncertainty": "not_specified", "citation": null}, "proration_policy": {"value": null, "uncertainty": "not_specified", "citation": null}, "blackout_periods": {"value": null, "uncertainty": "not_specified", "citation": null}}, "terms_changes": {"notice_channels": {"value": ["email", "web_notice"], "uncertainty": "confirmed", "citation": null}, "notice_lead_time_days": {"value": 30, "uncertainty": "inferred", "citation": {"page": 0, "section": "paragraph", "bbox": null, "quote": "합리적인 기간", "pain_point_id": null}}, "user_consent_mechanism": {"value": "opt_out_available", "uncertainty": "inferred", "citation": null}, "user_right_to_terminate_on_change": {"value": true, "uncertainty": "confirmed", "citation": {"page": 10, "section": "paragraph", "bbox": null, "quote": "당사는 수시로 본 약관을 변경할 수 있습니다. 변경된 내용은 본 약관의 필수적인 일부를 구성합니다.", "pain_point_id": null}}, "silent_acceptance_clause": {"value": true, "uncertainty": "confirmed", "citation": null}}, "data_usage": {"collected_categories": {"value": ["계정 정보 (이메일, 전화번호, 생년월일 등)", "입력 정보 (프롬프트, 텍스트, 음성, 파일 등)", "자동 수집 정보 (IP 주소, 기기 식별자, 쿠키, 로그, 위치 정보, 결제 정보 등)"], "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "당사는 세 가지 방법을 통해 귀하의 정보를 수집합니다: ‘귀하가 제공하는 정보’, ‘자동적으로 수집되는 정보’ 및 ‘기타 출처에서 수집하는 정보’.", "pain_point_id": null}}, "third_party_sharing": {"value": true, "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "당사는 본 개인정보 처리방침에 명시된 정보를 다음과 같은 다른 출처로부터 수집할 수 있습니다.", "pain_point_id": null}}, "third_party_recipients": {"value": ["Beijing DeepSeek Artificial Intelligence Co., Ltd.", "Beijing Volcano Engine Technology Co., Ltd.", "Intuition Machines, Inc."], "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "당사는 본 개인정보 처리방침에 명시된 정보를 다음과 같은 다른 출처로부터 수집할 수 있습니다.", "pain_point_id": null}}, "third_party_purposes": {"value": ["서비스 운영 및 개선", "오류 방지 및 해결", "봇 차단 및 이용자 확인", "모델 훈련 및 최적화"], "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "당사는 다음 목적을 포함하여 서비스를 운영, 제공, 개발, 개선하기 위해 귀하의 정보를 이용합니다.", "pain_point_id": null}}, "retention_period_months": {"value": 60, "uncertainty": "confirmed", "citation": {"page": 0, "section": "paragraph", "bbox": null, "quote": "5년(전자상거래 등에서의 「소비자보호에 관한 법률」 제6조)", "pain_point_id": null}}, "marketing_use": {"value": true, "uncertainty": "confirmed", "citation": {"page": 0, "section": "paragraph", "bbox": null, "quote": "플랫폼 변경 사항 알림, 고객 지원 제공, 기타 서비스 관련 메시지 또는 상업적 메시지 발송", "pain_point_id": null}}, "marketing_consent": {"value": "opt_in_explicit", "uncertainty": "inferred", "citation": {"page": 0, "section": null, "bbox": null, "quote": "당사는 귀하의 개인정보를 이전합니다.", "pain_point_id": null}}, "cross_border_transfer": {"value": true, "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "필요한 경우, 본 개인정보 처리방침에 명시된 목적을 위해 특정 국가 외부로 개인정보를 이전할 수 있습니다.", "pain_point_id": null}}}, "liability": {"service_disruption_compensation": {"value": false, "uncertainty": "confirmed", "citation": {"page": 7, "section": "paragraph", "bbox": null, "quote": "본 서비스는 “있는 그대로” 및 “이용 가능한 상태”로 제공되며, 당사는 본 서비스와 관련하여 명시적이든 묵시적이든 어떤 보증, 진술, 약정도 귀하에게 제공하지 않습니다.", "pain_point_id": null}}, "compensation_description": {"value": "No compensation for service disruption", "uncertainty": "inferred", "citation": {"page": 7, "section": "paragraph", "bbox": null, "quote": "본 서비스는 “있는 그대로” 및 “이용 가능한 상태”로 제공되며, 당사는 본 서비스와 관련하여 명시적이든 묵시적이든 어떤 보증, 진술, 약정도 귀하에게 제공하지 않습니다.", "pain_point_id": null}}, "damages_cap_present": {"value": true, "uncertainty": "confirmed", "citation": {"page": 7, "section": "paragraph", "bbox": null, "quote": "달리 합의된 경우가 아니면 어느 당사자도 상대방의 부수적 손해, 결과적 손해, 징벌적 손해, 특별 손해 또는 간접 손해에 대해 책임을 지지 않습니다.", "pain_point_id": null}}, "damages_cap_description": {"value": null, "uncertainty": "not_specified", "citation": null}, "force_majeure_scope": {"value": "force majeure", "uncertainty": "confirmed", "citation": {"page": 8, "section": "paragraph", "bbox": null, "quote": "당사는 본 서비스의 보안과 안정적인 운영을 위해 필요한 조치를 업계 관행에 상응하는 수준으로 취하고 있습니다.", "pain_point_id": null}}, "indirect_damages_excluded": {"value": true, "uncertainty": "confirmed", "citation": {"page": 7, "section": "paragraph", "bbox": null, "quote": "달리 합의된 경우가 아니면 어느 당사자도 상대방의 부수적 손해, 결과적 손해, 징벌적 손해, 특별 손해 또는 간접 손해에 대해 책임을 지지 않습니다.", "pain_point_id": null}}}, "disputes": {"governing_law": {"value": "중화인민공화국", "uncertainty": "confirmed", "citation": {"page": 9, "section": "paragraph", "bbox": null, "quote": "본 약관의 성립, 체결, 해석, 분쟁 해결에는 중화인민공화국의 법률이 적용됩니다.", "pain_point_id": null}}, "jurisdiction_clause": {"value": "Hangzhou, China", "uncertainty": "confirmed", "citation": {"page": 9, "section": null, "bbox": null, "quote": "당사자들은 Hangzhou DeepSeek Artificial Intelligence Co., Ltd.의 주 소재지를 관할하는 법원에 소송을 제기할 수 있습니다.", "pain_point_id": null}}, "arbitration_required": {"value": false, "uncertainty": "confirmed", "citation": null}, "class_action_waiver": {"value": false, "uncertainty": "not_specified", "citation": null}}, "unfair_clause_flags": ["14세 미만 어린이 정보", "간접 손해 배제", "계정 삭제 후 데이터 보유", "데이터 보관 기간", "동의 거부 시 서비스 제한", "동의 철회 시 계정 삭제", "보증 부인", "서비스 중단에 대한 보상 없음", "위치 정보 수집", "자동 동의", "자동 수집", "제3자 공유", "제3자 콘텐츠 책임 부인", "책임 제한"], "raw_document_hash": null}, "summary": "DeepSeek 이용약관은 개인정보 수집·제3자 제공·해외 이전, 자동 갱신 및 가격 변동 고지, 데이터 보관 기간, 손해배상 제한 및 관할법 등 주요 조항을 포함하고 있습니다. 특히 해외 데이터 이전 및 제3자 공유, 데이터 보관 기간, 손해배상 제한 등은 소비자에게 중요한 영향을 미칠 수 있으며, 마케팅 동의와 관련된 절차도 명확히 확인해야 합니다.", "key_clauses": [{"title": "해외 데이터 이전", "description": "서비스가 필요한 경우, 귀하의 개인정보를 중국 외의 특정 국가로 이전할 수 있습니다. 이는 개인정보 보호 수준이 다를 수 있어 개인정보 유출 위험이 있습니다.", "risk_level": "medium", "pain_point_id": "PRE-01", "citation": {"page": 1, "quote": "필요한 경우, 본 개인정보 처리방침에 명시된 목적을 위해 특정 국가 외부로 개인정보를 이전할 수 있습니다."}}, {"title": "데이터 보관 기간", "description": "귀하의 개인정보는 최소 5년(전자상거래 등에서의 「소비자보호에 관한 법률」 제6조)까지 보관됩니다. 이는 장기간 데이터가 남아 있을 수 있음을 의미합니다.", "risk_level": "medium", "pain_point_id": "PRE-03", "citation": {"page": 0, "quote": "5년(전자상거래 등에서의 「소비자보호에 관한 법률」 제6조)"}}, {"title": "손해배상 제한", "description": "서비스 이용 중 발생한 부수적·결과적·징벌적·특별·간접 손해에 대해 당사는 책임을 지지 않습니다. 즉, 서비스 장애나 데이터 손실 등에 대한 보상을 받을 수 없습니다.", "risk_level": "medium", "pain_point_id": "POST-01", "citation": {"page": 7, "quote": "달리 합의된 경우가 아니면 어느 당사자도 상대방의 부수적 손해, 결과적 손해, 징벌적 손해, 특별 손해 또는 간접 손해에 대해 책임을 지지 않습니다."}}], "ungrounded_clauses": [{"title": "제3자 정보 공유", "description": "귀하의 개인정보를 Beijing DeepSeek Artificial Intelligence Co., Ltd., Beijing Volcano Engine Technology Co., Ltd., Intuition Machines, Inc. 등 제3자에게 제공할 수 있습니다. 공유 목적은 서비스 운영, 오류 방지, 모델 훈련 등이며, 공유 범위가 광범위합니다.", "risk_level": "medium", "pain_point_id": "PRE-02", "citation": {"page": 1, "quote": "당사는 본 개인정보 처리방침에 명시된 정보를 다음과 같은 다른 출처로부터 수집할 수 있습니다."}}, {"title": "마케팅 동의", "description": "귀하의 개인정보를 마케팅 목적으로 사용할 수 있으며, 명시적 동의(opt_in_explicit)를 요구합니다. 그러나 동의 철회 절차가 명시되지 않아 마케팅 수신 거부 시 계정 삭제 위험이 있습니다.", "risk_level": "medium", "pain_point_id": "PRE-04", "citation": {"page": 0, "quote": "당사는 귀하의 개인정보를 이전합니다."}}], "grounded": false, "timings": [{"stage": "parse", "seconds": 0.0032827499671839178}, {"stage": "extract", "seconds": 540.4395205829642}, {"stage": "summarize", "seconds": 47.805874624988064}, {"stage": "ground", "seconds": 61.71928304200992}], "usage": [{"stage": "parse", "calls": 0, "prompt_tokens": 0, "completion_tokens": 0, "reasoning_tokens": 0, "total_tokens": 0, "pages": 0}, {"stage": "extract", "calls": 5, "prompt_tokens": 58385, "completion_tokens": 23666, "reasoning_tokens": 13782, "total_tokens": 82051,