: null}, "retention_period_months": {"value": null, "uncertainty": "not_specified", "citation": null}, "marketing_use": {"value": null, "uncertainty": "not_specified", "citation": null}, "marketing_consent": {"value": null, "uncertainty": "not_specified", "citation": null}, "cross_border_transfer": {"value": null, "uncertainty": "not_specified", "citation": null}}, "liability": {"service_disruption_compensation": {"value": null, "uncertainty": "not_specified", "citation": null}, "compensation_description": {"value": null, "uncertainty": "not_specified", "citation": null}, "damages_cap_present": {"value": null, "uncertainty": "not_specified", "citation": null}, "damages_cap_description": {"value": null, "uncertainty": "not_specified", "citation": null}, "force_majeure_scope": {"value": null, "uncertainty": "not_specified", "citation": null}, "indirect_damages_excluded": {"value": null, "uncertainty": "not_specified", "citation": null}}, "disputes": {"governing_law": {"value": "대한민국 법률", "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "본 약관과 관련된 사항에 대하여는 대한민국 법률을 준거법으로 합니다.", "pain_point_id": null}}, "jurisdiction_clause": {"value": "민사소송법 상의 관할법원", "uncertainty": "confirmed", "citation": {"page": 1, "section": "paragraph", "bbox": null, "quote": "회사와 회원간 발생한 분쟁에 관한 소송은 민사소송법 상의 관할법원에 제소합니다.", "pain_point_id": null}}, "arbitration_required": {"value": null, "uncertainty": "not_specified", "citation": null}, "class_action_waiver": {"value": null, "uncertainty": "not_specified", "citation": null}}, "unfair_clause_flags": ["면책_손배_제한", "의사표시_의제"], "raw_document_hash": null}, "summary": "KakaoPay 서비스 약관은 자동 갱신 및 무료 체험이 명시되지 않았으며, 약관 변경 시 30일 전 사전 고지를 이메일 및 앱 내 배너로 제공하고, 거부의사를 표시하지 않을 경우 자동으로 동의한 것으로 간주하는 ‘의사표시 의제’ 조항이 포함되어 있습니다. 또한 회원은 언제든지 온라인(앱·웹)으로 계약을 해지할 수 있으나, 해지 시 위약금이나 사전 고지 의무는 없습니다. 이러한 구조는 가입 전·중·후 단계별로 소비자의 권리를 제한하거나 불확실성을 초래할 수 있는 위험이 존재합니다.", "key_clauses": [{"title": "약관 변경 동의 방식", "description": "소비자가 약관 변경 시 별도의 동의 절차를 거치지 않고, 거부의사를 표시하지 않으면 자동으로 동의한 것으로 간주하는 조항입니다. 이는 소비자가 변경 내용을 인지하지 못한 채 자동으로 유료 전환되거나 불리한 조건에 묶일 위험이 있습니다. 예를 들어, 이메일이나 앱 알림을 확인하지 않으면 변경된 약관이 그대로 적용되어 추가 비용이 부과될 수 있습니다.", "risk_level": "high", "pain_point_id": "MID-01", "citation": {"page": 1, "quote": "거부의사를 표시하지 않을 경우 개정 약관에 동의한 것으로 본다"}}, {"title": "계약 해지 방법", "description": "회원은 카카오페이 앱이나 웹을 통해 언제든지 이용계약을 해지할 수 있으며, 회사는 관련 법령에 따라 즉시 처리해야 합니다. 해지 절차가 온라인으로만 제공되어 접근성이 높지만, 해지 전 사전 고지나 위약금 규정이 없어 해지 자체는 자유롭게 할 수 있습니다.", "risk_level": "low", "pain_point_id": "POST-02", "citation": {"page": 1, "quote": "회원은 언제든지 이용계약 해지 신청을 할 수 있으며, 회사는 관련 법령 등이 정하는 바에 따라 이를 즉시 처리하여야 합니다."}}], "ungrounded_clauses": [{"title": "약관 변경 사전 고지 기간", "description": "약관 변경 사항을 최소 30일 전에 고지하도록 규정하고 있으나, 실제 고지는 ‘1월 전에 공지’라는 모호한 표현으로 되어 있어 소비자가 충분히 검토할 시간을 확보하지 못할 가능성이 있습니다. 짧은 고지 기간은 소비자가 변경 내용을 파악하고 대응할 여유를 제한합니다.", "risk_level": "medium", "pain_point_id": "MID-02", "citation": {"page": 1, "quote": "1월 전에 공지"}}, {"title": "약관 변경 고지 채널", "description": "약관 변경 고지는 이메일 및 앱 내 배너·팝업 화면으로만 제공된다고 명시되어 있습니다. 이는 소비자가 해당 채널을 확인하지 않을 경우 변경 사항을 전혀 알지 못하게 되는 위험을 내포합니다. 특히 이메일 스팸 처리나 앱 알림 비활성화로 인해 중요한 변경 고지를 놓칠 수 있습니다.", "risk_level": "medium", "pain_point_id": "MID-01", "citation": {"page": 1, "quote": "본 약관은 카카오페이 서비스의 화면 내 또는 별도의 연결화면에 게시하거나 팝업화면 등으로 제공합니다."}}], "grounded": false, "timings": [{"stage": "parse", "seconds": 0.008806958969216794}, {"stage": "extract", "seconds": 224.2308085000259}, {"stage": "summarize", "seconds": 65.76234041602584}, {"stage": "ground", "seconds": 170.70362508302787}], "usage": [{"stage": "parse", "calls": 0, "prompt_tokens": 0, "completion_tokens": 0, "reasoning_tokens": 0, "total_tokens": 0, "pages": 0}, {"stage": "extract", "calls": 5, "prompt_tokens": 124225, "completion_tokens": 25116, "reasoning_tokens": 16700, "total_tokens": 149341, "pages": 0}, {"stage": "summarize", "calls": 1, "prompt_tokens": 2598, "completion_tokens": 2710, "reasoning_tokens": 2104, "total_tokens": 5308, "pages": 0}, {"stage"